FROM python:3.12-slim

ARG UID=1000
ARG GID=1000

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /app

RUN set -eux; \
    if [ "${UID}" = "0" ] || [ "${GID}" = "0" ]; then \
        echo "UID/GID must not superuser. build by a normal user"; \
        exit 1; \
    fi; \
    if ! getent group "${GID}" > /dev/null; then \
        groupadd -g "${GID}" appgroup; \
    fi; \
    if ! getent passwd "${UID}" > /dev/null; then \
        useradd -m -u "${UID}" -g "${GID}" -s /usr/sbin/nologin appuser; \
    fi

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

RUN mkdir -p \
        /app/sqlite \
        /app/uploads/file \
        /app/uploads/img/thumb1 \
        /app/uploads/img/thumb2 \
        /app/uploads/img/thumb3 \
    && chown -R ${UID}:${GID} /app

USER ${UID}:${GID}

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).read()" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
